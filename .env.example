# Copy to .env.local for local dev; add the same keys in Vercel → Project → Settings → Environment Variables.
# Everything is optional: with nothing set, the app runs on in-memory demo data with a sample bill.

# Google AI Studio key (https://aistudio.google.com/apikey). Enables photo reading + the agent.
GEMINI_API_KEY=
# Optional model override (must be available on the v1 API for your key).
GEMINI_MODEL=gemini-3.8-flash

# Supabase (Project Settings → API). Run supabase/migrations/0001_init.sql first.
# The service-role key is server-only; never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio WhatsApp Sandbox (Console → Messaging → Try it out → WhatsApp).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set if Twilio signs a different URL than the request host (custom domains / proxies).
PUBLIC_BASE_URL=
# Unknown WhatsApp numbers talk to this demo shop (read/update only, no approvals). Set to false to refuse them.
WHATSAPP_DEMO_FALLBACK=true
WHATSAPP_DEMO_SHOP_ID=shop-sharma

# Protects /api/cron/daily-brief and /api/admin/reset. Vercel Cron sends it automatically.
CRON_SECRET=
# Allow the "Reset demo data" button against Supabase (keep false for real shops).
ALLOW_DEMO_RESET=false

# Comma-separated models tried when the primary is overloaded (503) or rate-limited (429).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Signs login cookies. Any long random string. If unset, one is derived from SUPABASE_SERVICE_ROLE_KEY.
SESSION_SECRET=
